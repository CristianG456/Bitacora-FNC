# ================================================================
# APP — OBLIGATORIO
# ================================================================
APP_NAME="Sistema Juridico FNC"
APP_ENV=production
APP_KEY=CAMBIAR_ESTE_VALOR_BASE64_GENERADO_CON_ARTISAN
APP_DEBUG=false
APP_URL=http://192.168.76.161:8010
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
# AVISO: config/app.php de v1.5.18 fija UTC y no lee APP_TIMEZONE.
APP_TIMEZONE=UTC
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file
APP_PREVIOUS_KEYS=
BCRYPT_ROUNDS=12

# ================================================================
# DATABASE — OBLIGATORIO / NO EXPONER CONTRASEÑAS
# ================================================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=juridica
DB_USERNAME=juridica
DB_PASSWORD=CAMBIAR_ESTE_VALOR_DB_USUARIO
DB_ROOT_PASSWORD=CAMBIAR_ESTE_VALOR_DB_ROOT_DISTINTO
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ================================================================
# SESSION — OBLIGATORIO
# ================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# La URL objetivo es HTTP. Cambiar a true únicamente cuando exista HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
SESSION_COOKIE=juridica_session

# ================================================================
# LOGGING — OBLIGATORIO
# ================================================================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
LOG_DAILY_DAYS=14

# ================================================================
# CACHE — OBLIGATORIO
# ================================================================
CACHE_STORE=file
CACHE_PREFIX=juridica_cache

# ================================================================
# QUEUE — OBLIGATORIO
# No existe worker de cola en este compose; sync evita trabajos pendientes.
# ================================================================
QUEUE_CONNECTION=sync

# ================================================================
# FILESYSTEM — OBLIGATORIO
# ================================================================
FILESYSTEM_DISK=local

# ================================================================
# MAIL GLOBAL — OPCIONAL / CREDENCIALES NO EXPONER
# El módulo de backups puede sobrescribir SMTP desde backup_settings.
# ================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=CAMBIAR_HOST_SMTP
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR_USUARIO_SMTP
MAIL_PASSWORD=CAMBIAR_ESTE_VALOR_SMTP
MAIL_FROM_ADDRESS=CAMBIAR_REMITENTE@DOMINIO.COM
MAIL_FROM_NAME="Sistema Juridico FNC"
# Compatibilidad documental: config/mail.php v1.5.18 no lee MAIL_ENCRYPTION.
MAIL_ENCRYPTION=tls

# ================================================================
# BROADCASTING
# v1.5.18 no incluye Reverb, Laravel Echo ni Pusher.
# ================================================================
BROADCAST_CONNECTION=log
# ================================================================
# VITE / NAVEGADOR
# El Dockerfile compila estos assets durante el build de la imagen.
# ================================================================
VITE_APP_NAME="Sistema Juridico FNC"
# ================================================================
# CLOUDFLARE R2 — OPCIONAL / SECRETOS NO EXPONER
# ================================================================
R2_ACCOUNT_ID=CAMBIAR_ACCOUNT_ID
R2_ACCESS_KEY_ID=CAMBIAR_ACCESS_KEY
R2_SECRET_ACCESS_KEY=CAMBIAR_SECRET_KEY
R2_BUCKET=CAMBIAR_BUCKET
R2_ENDPOINT=https://CAMBIAR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=true

# ================================================================
# AWS/S3 GENÉRICO — OPCIONAL / NO USADO POR R2 DEL PROYECTO
# ================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ================================================================
# ADMIN INICIAL — OBLIGATORIO / NO EXPONER CONTRASEÑA
# ================================================================
ADMIN_EMAIL=CAMBIAR_ADMIN@DOMINIO.COM
ADMIN_PASSWORD=CAMBIAR_ESTE_VALOR_ADMIN

# ================================================================
# BACKUPS
# No existen variables BACKUP_*, ZIP_* o RETENTION_* leídas por v1.5.18.
# Frecuencia, hora, contraseña ZIP, destinatarios y retención se guardan
# en la tabla backup_settings desde el módulo de Respaldos.
# ================================================================